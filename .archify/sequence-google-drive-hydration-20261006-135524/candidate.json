  "cards": [
    {
      "dot": "rose",
      "title": "The Root Cause Trap",
      "items": [
        "Floodlight index-root was set to /Users/martinfan with no CloudStorage exclusion",
        "It walked inside ~/Library/CloudStorage/GoogleDrive and called open() on files",
        "APFS treats any read() on a UF_DATALESS file as an intentional user download request"
      ]
    },
    {
      "dot": "amber",
      "title": "The Hidden 10 MB/s Download",
      "items": [
        "Google Drive was configured for cloud-only (0 bytes offline files)",
        "fileproviderd pulled bytes from Google servers at 10 MB/s to satisfy the read() call",
        "Downloaded files accumulated on SSD blocks under 'recently opened files' cache"
      ]
    },
    {
      "dot": "emerald",
      "title": "Solution & Best Practice",
      "items": [
        "Killing Floodlight immediately halted the 10 MB/s download stream",
        "Evicted physical blocks via evictUbiquitousItem (reclaimed 22 GB back to 0 bytes)",
        "Search tools must inspect NSURLIsUbiquitousItemKey and skip unhydrated files"
      ]
    }
  ]
}
