{
  "$comment": "TypeScript + Effect-TS project. Stack: tsc --lsp (TS 7 native, 10-30x faster than tsserver) for types, oxlint for diagnostics. TS 7 loads no tsserver plugins, so stock tsc --lsp has no Effect diagnostics. Run `bunx @effect/tsgo setup`, then set tsc.command to the absolute path printed by `bunx effect-tsgo get-exe-path` (the Effect build of TS 7; use it instead of tsc, not alongside it). Drop at project root as .lsp.json.",
  "lspServers": {
    "tsc": {
      "command": "tsc",
      "args": ["--lsp", "--stdio"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "initializationOptions": {
        "preferences": {
          "includeInlayParameterNameHints": "all",
          "includeInlayFunctionLikeReturnTypeHints": true,
          "includeInlayVariableTypeHints": true,
          "includeInlayPropertyDeclarationTypeHints": true,
          "importModuleSpecifierPreference": "non-relative",
          "quotePreference": "double"
        }
      }
    },
    "oxlint": {
      "command": "oxlint",
      "args": ["--lsp"],
      "extensionToLanguage": {
        ".ts": "typescript",
        ".tsx": "typescriptreact",
        ".mts": "typescript",
        ".cts": "typescript",
        ".js": "javascript",
        ".jsx": "javascriptreact",
        ".mjs": "javascript",
        ".cjs": "javascript"
      },
      "isLinter": true
    }
  },
  "$tsconfig_reminder": "tsconfig.json must include: { \"compilerOptions\": { \"plugins\": [{ \"name\": \"@effect/language-service\" }] } }"
}
