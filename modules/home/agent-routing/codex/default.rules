# Posting guard (issue #367, ADR-0015 decision 2): PR comments and reviews are
# user-invoked only. Under approval_policy = "never" a "prompt" decision cannot
# be approved, so the command fails closed and the agent prints it for the user.
#
# Scope honesty: this is a prefix guard on exactly these two commands, not a
# boundary on every GitHub write. `gh api` writes and shells spawned outside
# the execpolicy path stay unguarded; the routing block's Posting rule is the
# only control there.
#
# Validate after changes:
#   codex execpolicy check --pretty --rules ~/.codex/rules/default.rules -- gh pr comment 1 --body x
#   codex execpolicy check --pretty --rules ~/.codex/rules/default.rules -- gh pr review 1 --approve

prefix_rule(
    pattern = ["gh", "pr", "comment"],
    decision = "prompt",
    justification = "PR comments are user-invoked only (ADR-0015 decision 2)",
)

prefix_rule(
    pattern = ["gh", "pr", "review"],
    decision = "prompt",
    justification = "PR reviews are user-invoked only (ADR-0015 decision 2)",
)
